}

@media (width >= 768px) and (width <= 1279px) {
  .orlyata-home {
    --home-tablet-panel-height: clamp(24.394rem, 50.821vw, 40.625rem);
    --home-tablet-news-card-height: clamp(10.133rem, 21.11vw, 16.875rem);
    --home-tablet-facts-height: clamp(6.38rem, 13.292vw, 10.625rem);
    --home-tablet-media-big-height: clamp(28.536rem, 59.421vw, 47.5rem);
    --home-tablet-history-height: clamp(19.515rem, 40.656763vw, 32.5rem);
    --home-tablet-history-text-scale: clamp(0.600469, calc(100vw / 1279px), 1);
    --home-tablet-history-lead-reference-width: 37.5rem;
    --home-tablet-history-copy-reference-width: 34.59375rem;
    --home-tablet-history-lead-reference-size: 2.25rem;
    --home-tablet-history-copy-reference-size: 1.25rem;
    --home-tablet-history-lead-reference-tracking: -0.03125rem;
    --home-tablet-history-copy-reference-tracking: 0;
  }

  .orlyata-home__hero { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .orlyata-home__hero-panel { min-height: var(--home-tablet-panel-height); aspect-ratio: auto; }
  .orlyata-home__news-grid { grid-template-columns: 1fr; inset-inline: var(--space-5); bottom: calc(var(--space-5) + var(--space-5) + var(--space-4)); }
  .orlyata-home__news-grid > .orlyata-news-card { block-size: var(--home-tablet-news-card-height); aspect-ratio: auto; }
  .orlyata-home__facts .orlyata-advantage { block-size: var(--home-tablet-facts-height); aspect-ratio: auto; }
  .orlyata-home__media-grid .orlyata-media-card--big { block-size: var(--home-tablet-media-big-height); aspect-ratio: auto; }
  .orlyata-home__history { block-size: var(--home-tablet-history-height); aspect-ratio: auto; }
  .orlyata-home__history-lead,
  .orlyata-home__history-copy {
    max-inline-size: none;
    transform: scale(var(--home-tablet-history-text-scale));
    transform-origin: top left;
  }
  .orlyata-home__history-lead {
    inline-size: var(--home-tablet-history-lead-reference-width);
    font-size: var(--home-tablet-history-lead-reference-size);
    letter-spacing: var(--home-tablet-history-lead-reference-tracking);
  }
  .orlyata-home__history-copy {
    inline-size: var(--home-tablet-history-copy-reference-width);
    font-size: var(--home-tablet-history-copy-reference-size);
    letter-spacing: var(--home-tablet-history-copy-reference-tracking);
  }
  .orlyata-home__history-grid { grid-template-columns: var(--home-history-lead-width) minmax(0, 1fr); block-size: calc(100% - var(--font-size-heading-2) - var(--space-5)); }
  .orlyata-home__history-intro, .orlyata-home__history-details { display: flex; flex-direction: column; }
  .orlyata-home__history-tags, .orlyata-home__history-teachers { margin-block-start: auto; }
  .orlyata-home__application-surface { block-size: auto; min-block-size: calc(var(--application-form-min-height) + var(--home-application-surface-padding) + var(--home-application-surface-padding)); }
}

@media (width >= 768px) and (width <= 1279px) {
  .orlyata-home__news-pagination {
    position: absolute;
    inset-block-end: var(--space-5);
    inset-inline: 0;
    display: flex;
    justify-content: center;
    gap: var(--space-4);
  }

  .orlyata-home__news-pagination-button {
    inline-size: var(--about-life-pagination-dot-size);
    block-size: var(--about-life-pagination-dot-size);
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: var(--color-text-secondary-on-inverse);
  }

  .orlyata-home__news-pagination-button.is-active { background: var(--color-text-inverse); }
  .orlyata-home__news-pagination-button:focus-visible { outline: var(--focus-ring-width) solid var(--color-text-inverse); outline-offset: var(--focus-ring-offset); }
}

@media (width >= 768px) and (width <= 1279px) {
  .orlyata-home__history-grid {
    display: grid;
    align-items: stretch;
    block-size: calc(100% - var(--font-size-heading-2) - var(--space-5));
  }

  .orlyata-home__history-intro,
  .orlyata-home__history-details {
    min-block-size: 0;
  }

  .orlyata-home__application-surface {
    display: grid;
    place-items: center;
  }


}
@media (width >= 768px) and (width <= 1279px) {
  .orlyata-home__news-grid {
    bottom: calc(var(--space-5) + var(--about-life-pagination-dot-size) + var(--space-4));
  }

  .orlyata-home__media-grid .orlyata-media-card--small .orlyata-media-card__title {
    inline-size: 80%;
  }

  .orlyata-home__media-section + .orlyata-home__history {
    margin-block-start: var(--layout-section-gap);
  }

  .orlyata-home__application-surface {
    max-inline-size: 100%;
    overflow: hidden;
  }

  .orlyata-home__application-surface .orlyata-application-form {
    max-inline-size: calc(100% - var(--home-application-surface-padding) - var(--home-application-surface-padding));
  }


}
 @media (width >= 768px) and (width <= 1279px) {
  .orlyata-home__hero-panel--news { touch-action: pan-y; }
}

@media (width >= 768px) and (width <= 1279px) {
  .orlyata-home__news-viewport {
    position: absolute;
    z-index: 1;
    inset-inline: var(--space-5);
    inset-block-end: calc(var(--space-5) + var(--about-life-pagination-dot-size) + var(--space-4));
    overflow: hidden;
  }

  .orlyata-home__news-grid {
    position: static;
    inset: auto;
    inline-size: 100%;
    margin: 0;
    display: flex;
    gap: 0;
    transition: transform var(--duration-about-life-slide-transition) var(--easing-out);
    will-change: transform;
  }

  .orlyata-home .orlyata-home__news-grid > .orlyata-news-card:nth-child(n) {
    display: flex;
    flex: 0 0 100%;
    min-block-size: 0;
    block-size: var(--home-tablet-news-card-height);
  }

  .orlyata-home__news-viewport[data-home-news-active="1"] .orlyata-home__news-grid {
    transform: translateX(-100%);
  }
}

@media (width >= 768px) and (width <= 1279px) {
  .orlyata-home__achievements .orlyata-data-table--achievements tbody tr {
    grid-auto-rows: minmax(var(--accordion-row-height), max-content);
  }

  .orlyata-home__achievements .orlyata-data-table--achievements tbody td {
    block-size: auto;
    min-block-size: var(--accordion-row-height);
    align-content: start;
  }
}


@media (width <= 767px) {
  .orlyata-home :is(.orlyata-home__news-head, .orlyata-home__section-head) :is(.orlyata-text-link__icon-track, .orlyata-text-link__icon) {
    inline-size: 1.5rem;
    block-size: 1.5rem;
  }

  .orlyata-home__hero-dialog-close svg,
  .orlyata-home__history-teachers-link img {
    inline-size: var(--icon-size-ui-mobile);
    block-size: var(--icon-size-ui-mobile);
  }

  .orlyata-home__hero-dialog-close svg path {
    stroke-width: var(--icon-stroke-ui-mobile);
  }
}


/* Tablet achievements uses block data cells, while header labels remain vertically centred grid cells. */
@media (width >= 768px) and (width <= 1279px) {
  .orlyata-home__achievements .orlyata-data-table--achievements thead th {
    display: grid;
    align-content: center;
  }
}

/* Keep the tablet history section on the same four-column composition as desktop. */
@media (width >= 768px) and (width <= 1279px) {
  .orlyata-home__history-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .orlyata-home__history-intro,
  .orlyata-home__history-details {
    display: contents;
  }

  .orlyata-home__history-copy,
  .orlyata-home__history-tags {
    grid-column: 1 / span 2;
  }

  .orlyata-home__history-lead,
  .orlyata-home__history-teachers {
    grid-column: 3 / -1;
  }

  .orlyata-home__history-copy,
  .orlyata-home__history-lead {
    grid-row: 1;
  }

  .orlyata-home__history-tags,
  .orlyata-home__history-teachers {
    position: static;
    grid-row: 2;
    align-self: end;
    justify-self: start;
    margin-block-start: 0;
  }
}

/* Tablet S_t: global component radii use the 1279px reference values. */
@media (width >= 768px) and (width <= 1279px) {
  :root {
    --radius-small: clamp(0.300235rem, 0.625489vw, 0.5rem);
    --radius-medium: clamp(0.600469rem, 1.250977vw, 1rem);
    --radius-large: clamp(0.900704rem, 1.876466vw, 1.5rem);
  }
}

/* History text starts on one shared baseline in every responsive mode. */
.orlyata-home__history-lead,
.orlyata-home__history-copy {
  margin-block-start: 0;
}

/* Offset the history creation statement upward by 8px at the 1920px/1279px references. */
@media (width >= 1280px) {
  .orlyata-home__history-lead {
    translate: 0 clamp(-0.666667rem, -0.416667vw, -0.333333rem);
  }
}

@media (width >= 768px) and (width <= 1279px) {
  .orlyata-home__history-lead {
    translate: 0 calc(-0.5rem * var(--home-tablet-history-text-scale));
  }
}

@media (width <= 767px) {
  .orlyata-home__history-copy {
    margin-block-start: var(--space-5);
  }
}

/* Figma 4897:888: desktop/tablet History is a 520px reference composition. */
@media (width >= 768px) {
  .orlyata-home__history > .orlyata-home__section-head {
    display: none;
  }

  .orlyata-home__history {
    min-block-size: 0;
    block-size: var(--home-history-height);
    aspect-ratio: auto;
    padding-block-start: var(--space-5);
  }

  .orlyata-home__history-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: minmax(0, 1fr);
    align-items: stretch;
    min-block-size: 0;
    block-size: 100%;
    margin-block-start: 0;
  }

  .orlyata-home__history-intro,
  .orlyata-home__history-details {
    display: grid;
    grid-row: 1;
    align-self: stretch;
    min-block-size: 0;
    block-size: 100%;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  .orlyata-home__history-intro {
    grid-column: 3 / -1;
  }

  .orlyata-home__history-details {
    grid-column: 1 / span 2;
  }

  .orlyata-home__history-title,
  .orlyata-home__history-copy,
  .orlyata-home__history-lead,
  .orlyata-home__history-tags,
  .orlyata-home__history-teachers {
    grid-column: auto;
    grid-row: auto;
  }

  .orlyata-home__history-title {
    display: block;
    margin: 0;
  }

  .orlyata-home__history-copy {
    align-self: start;
    margin-block-start: var(--space-5);
  }

  .orlyata-home__history-lead {
    align-self: start;
    margin: 0;
    translate: none;
  }

  .orlyata-home__history-tags,
  .orlyata-home__history-teachers {
    position: static;
    align-self: end;
    justify-self: start;
    margin: 0;
  }

  .orlyata-home__history-tag {
    border: 0;
    background: var(--color-surface-muted);
  }
}

@media (width >= 768px) and (width <= 1279px) {
  .orlyata-home__history {
    block-size: var(--home-tablet-history-height);
  }
}

@media (width <= 767px) {
  .orlyata-home__history-title {
    display: none;
  }

  .orlyata-home__history > .orlyata-home__section-head .orlyata-text-link {
    display: none;
  }
}
