@media (width >= 768px) and (width <= 1279px) {
  .orlyata-home__content {
    padding-block-start: 0;
  }
}

@media (width <= 767px) {
  .orlyata-home .orlyata-home__hero-panel--capella::before {
    background: var(--home-mobile-hero-overlay);
  }

  .orlyata-home .orlyata-home__hero-panel--capella::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
    content: "";
    background: var(--home-mobile-hero-top-gradient);
  }

  .orlyata-home__hero-panel--news {
    padding: 0;
  }

  .orlyata-home__hero-panel--news .orlyata-home__hero-panel-content {
    position: relative;
    inset: auto;
  }

  .orlyata-home .orlyata-home__news-grid {
    inset: auto;
    margin-block-start: auto;
  }
}
@media (width >= 768px) and (width <= 1279px) {
  body.home,
  body:has(.orlyata-about),
  body:has(.orlyata-news),
  body:has(.orlyata-media-gallery),
  body:has(.orlyata-news-detail),
  :root:has(.orlyata-home),
  :root:has(.orlyata-about),
  :root:has(.orlyata-news),
  :root:has(.orlyata-media-gallery),
  :root:has(.orlyata-news-detail),
  .orlyata-home,
  .orlyata-about,
  .orlyata-news,
  .orlyata-media-gallery,
  .orlyata-news-detail {
    /* At 1279px these are the 1920px desktop values; every value below follows S_t. */
    --font-size-display: clamp(2.702111rem, 5.629398vw, 4.5rem);
    --font-size-heading-1: clamp(2.401876rem, 5.003909vw, 4rem);
    --font-size-heading-2: clamp(1.651291rem, 3.440188vw, 2.75rem);
    --font-size-lead: clamp(1.351056rem, 2.814699vw, 2.25rem);
    --font-size-heading-3: clamp(0.900704rem, 1.876466vw, 1.5rem);
    --font-size-body: clamp(0.750586rem, 1.563722vw, 1.25rem);
    --font-size-caption: clamp(0.52541rem, 1.094605vw, 0.875rem);
    --font-size-body-small: clamp(0.52541rem, 1.094605vw, 0.875rem);
    --letter-spacing-display: clamp(-0.125rem, -0.156372vw, -0.075059rem);
    --letter-spacing-heading-1: clamp(-0.0625rem, -0.078186vw, -0.037529rem);
    --letter-spacing-heading-2: clamp(-0.03125rem, -0.039093vw, -0.018765rem);
    --letter-spacing-lead: clamp(-0.03125rem, -0.039093vw, -0.018765rem);
    --letter-spacing-heading-3: 0;
    --letter-spacing-body: 0;
    --letter-spacing-caption: 0;
    --letter-spacing-body-small: 0;
    --space-1: clamp(0.150117rem, 0.500391vw, 0.25rem);
    --space-2: clamp(0.300235rem, 1.000782vw, 0.5rem);
    --space-4: clamp(0.600469rem, 2.001564vw, 1rem);
    --space-5: clamp(0.900704rem, 3.002346vw, 1.5rem);
    --space-6: clamp(1.200938rem, 4.003127vw, 2rem);
    --space-7: clamp(1.501173rem, 5.003909vw, 2.5rem);
    --radius-small: clamp(0.300235rem, 1.000782vw, 0.5rem);
    --radius-medium: clamp(0.600469rem, 2.001564vw, 1rem);
    --radius-large: clamp(0.900704rem, 3.002346vw, 1.5rem);
    --button-height: clamp(2.401876rem, 5.003680vw, 4rem);
    --badge-height: clamp(2.401876rem, 5.003680vw, 4rem);
    --badge-icon-size: clamp(2.401876rem, 5.003680vw, 4rem);
    --badge-icon-gap: clamp(0.150117rem, 0.312744vw, 0.250000rem);
    --badge-icon-glyph-size: clamp(0.900704rem, 1.876466vw, 1.5rem);
    --news-card-category-glyph-size: clamp(1.5rem, 2.501955vw, 2rem);
    --button-padding-block: clamp(0.450352rem, 1.501173vw, 0.75rem);
    --button-padding-inline: clamp(0.900704rem, 3.002346vw, 1.5rem);
    --button-gap: clamp(0.300235rem, 1.000782vw, 0.5rem);
    --button-icon-size: clamp(0.900704rem, 3.002346vw, 1.5rem);
    --button-play-icon-size: clamp(0.600469rem, 2.001564vw, 1rem);
    --advantage-padding-block-start: clamp(0.900704rem, 3.002346vw, 1.5rem);
    --advantage-padding-inline: clamp(0.900704rem, 3.002346vw, 1.5rem);
    --advantage-padding-block-end: clamp(0.600469rem, 2.001564vw, 1rem);
    --advantage-accent-size: clamp(0.375293rem, 1.250977vw, 0.625rem);
    --news-card-aspect-ratio: 365 / 270;
    --news-card-padding: clamp(0.900704rem, 3.002346vw, 1.5rem);
    --news-card-gap: clamp(0.600469rem, 2.001564vw, 1rem);
    --media-card-big-padding-block: clamp(1.200938rem, 4.003127vw, 2rem);
    --media-card-big-padding-inline: clamp(0.900704rem, 3.002346vw, 1.5rem);
    --media-card-big-title-width: clamp(16.137608rem, 5.379203vw, 26.875rem);
    --media-card-small-content-gap: clamp(0.600469rem, 2.001564vw, 1rem);
    --media-card-small-play-offset-block: clamp(0.600469rem, 2.001564vw, 1rem);
    --sidebar-tablet-logo-width: clamp(6.755278rem, 14.073495vw, 11.25rem);
    --sidebar-tablet-logo-height: clamp(3.756685rem, 7.826427vw, 6.25625rem);
    --sidebar-tablet-menu-line-width: clamp(1.801407rem, 3.752932vw, 3rem);
    --footer-preceding-gap: clamp(4.503518rem, 9.382330vw, 7.5rem);
    --footer-tablet-brand-links-gap: clamp(2.401876rem, 5.003909vw, 4rem);
    --layout-section-gap: clamp(4.503518rem, 9.382330vw, 7.5rem);
    --home-history-height: clamp(20.412822rem, 6.805317vw, 34rem);
    --home-history-heading-offset: clamp(0.56294rem, 0.187647vw, 0.9375rem);
    --home-history-content-height: clamp(18.011728rem, 6.008444vw, 30rem);
    --home-history-grid-gap: clamp(0.600469rem, 2.001564vw, 1rem);
    --home-history-lead-width: clamp(25.894449rem, 53.948397vw, 43.125rem);
    --home-history-copy-width: clamp(23.279515rem, 48.475371vw, 38.75rem);
    --home-history-copy-offset-block: clamp(0.750586rem, 2.501955vw, 1.25rem);
    --home-history-teacher-size: clamp(3.752932rem, 12.509773vw, 6.25rem);
    --home-application-height: clamp(23.279515rem, 7.770320vw, 38.75rem);
    --home-application-surface-padding: clamp(1.501173rem, 5.003909vw, 2.5rem);
    --home-application-title-width: clamp(32.873729rem, 10.968819vw, 54.75rem);
    --home-application-title-gap: clamp(1.200938rem, 4.003127vw, 2rem);
    --application-form-width: clamp(18.761532rem, 6.254762vw, 31.25rem);
    --application-form-min-height: clamp(20.117279rem, 6.706615vw, 33.5rem);
    --application-form-padding: clamp(1.200938rem, 4.003127vw, 2rem);
    --application-form-gap: clamp(0.900704rem, 3.002346vw, 1.5rem);
    --application-form-fields-gap: clamp(0.600469rem, 2.001564vw, 1rem);
    --input-height: clamp(3rem, 5.003680vw, 4rem);
    --input-padding-inline: clamp(0.900704rem, 3.002346vw, 1.5rem);
  }

  .orlyata-home__content {
    padding-inline: var(--layout-content-gutter);
  }

  .orlyata-home__content-grid {
    width: 100%;
  }

  .orlyata-home__hero {
    grid-template-columns: 1fr;
  }

  .orlyata-home__hero-panel {
    grid-column: auto;
    min-height: 0;
    aspect-ratio: var(--home-tablet-hero-panel-aspect-ratio);
  }

  .orlyata-home__news-grid > .orlyata-news-card {
    padding: var(--news-card-padding);
  }

  .orlyata-home__facts {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: start;
  }

  .orlyata-home__facts .orlyata-advantage {
    min-height: 0;
    aspect-ratio: var(--advantage-aspect-ratio);
  }

  .orlyata-home__media-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .orlyata-home__media-grid .orlyata-media-card--big {
    grid-column: 1 / -1;
    height: auto;
    aspect-ratio: var(--media-card-big-aspect-ratio);
  }


  .orlyata-home__history {
    min-height: 0;
    aspect-ratio: var(--home-history-aspect-ratio);
  }

  .orlyata-home__history-grid,
  .orlyata-home__history-intro,
  .orlyata-home__history-details {
    min-height: 0;
  }

  .orlyata-home__application-surface {
    min-height: 0;
    aspect-ratio: var(--home-application-aspect-ratio);
  }

  .orlyata-home__history-tags,
  .orlyata-home__history-teachers {
    position: static;
    margin-block-start: var(--space-5);
  }

}

@media (width <= 767px) {
  /* Approved Home mobile geometry at the 393px reference. */
  .orlyata-home .orlyata-home__content {
    padding-block-start: 0;
  }

  .orlyata-home .orlyata-home__hero {
    inline-size: calc(100% + (var(--layout-content-gutter) * 2));
    margin-inline: calc(-1 * var(--layout-content-gutter));
    margin-block-start: 0;
  }

  .orlyata-home .orlyata-home__hero-panel--capella {
    min-block-size: var(--home-mobile-hero-height);
    block-size: var(--home-mobile-hero-height);
    border-radius: 0 0 var(--home-mobile-hero-radius) var(--home-mobile-hero-radius);
  }

  .orlyata-home :is(.orlyata-home__news-head, .orlyata-home__section-head) {
    flex-direction: row;
    align-items: center;
  }

  .orlyata-home :is(.orlyata-home__news-head, .orlyata-home__section-head) .orlyata-text-link {
    display: inline-flex;
    flex: 0 0 var(--icon-size-ui-mobile);
    inline-size: var(--icon-size-ui-mobile);
    block-size: var(--icon-size-ui-mobile);
    column-gap: 0;
  }

  .orlyata-home :is(.orlyata-home__news-head, .orlyata-home__section-head) .orlyata-text-link__label {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .orlyata-home :is(.orlyata-home__news-head, .orlyata-home__section-head) .orlyata-text-link__icon-track,
  .orlyata-home :is(.orlyata-home__news-head, .orlyata-home__section-head) .orlyata-text-link__icon {
    inline-size: var(--icon-size-ui-mobile);
    block-size: var(--icon-size-ui-mobile);
  }

  .orlyata-home .orlyata-home__hero-panel--capella > .orlyata-home__hero-title {
    position: absolute;
    inset-block-end: var(--home-mobile-hero-title-bottom-inset);
    inset-inline: var(--home-mobile-hero-content-inset);
  }

  .orlyata-home .orlyata-home__hero-play {
    inset-block-start: auto;
    inset-block-end: calc(var(--home-mobile-hero-title-bottom-inset) + (var(--font-size-display) * var(--line-height-display) * 3) + var(--home-mobile-hero-play-title-gap));
    inset-inline-start: var(--home-mobile-hero-content-inset);
    inline-size: var(--home-mobile-control-size);
    block-size: var(--home-mobile-control-size);
  }

  .orlyata-home .orlyata-home__hero-play .orlyata-button__icon--play {
    inline-size: var(--home-mobile-play-icon-size);
    block-size: var(--home-mobile-play-icon-size);
  }

  .orlyata-home .orlyata-home__hero-panel--news {
    display: flex;
    inline-size: calc(100% - (var(--layout-content-gutter) * 2));
    min-block-size: calc(var(--home-mobile-news-height) + var(--home-mobile-space-4));
    block-size: calc(var(--home-mobile-news-height) + var(--home-mobile-space-4));
    margin-inline: var(--layout-content-gutter);
    padding: 0;
    background-color: transparent;
  }

  .orlyata-home .orlyata-home__hero-panel--news .orlyata-home__hero-panel-content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: space-between;
    min-block-size: 0;
    padding: 0;
  }

  .orlyata-home__news-head {
    padding: var(--home-mobile-space-16) var(--home-mobile-space-12) 0;
  }

  .orlyata-home__news-grid {
    inset: auto;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--home-mobile-space-12);
    padding: 0 var(--home-mobile-space-12) var(--home-mobile-space-16);
    margin-block-start: 0;
  }

  .orlyata-home__news-pagination {
    display: none;
  }

  .orlyata-home .orlyata-home__news-grid > .orlyata-news-card {
    min-block-size: var(--home-mobile-news-card-height);
    block-size: var(--home-mobile-news-card-height);
    aspect-ratio: auto;
  }

  .orlyata-home__facts {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--home-mobile-space-12);
    margin-block-start: var(--home-mobile-space-16);
  }

  .orlyata-home .orlyata-home__facts .orlyata-advantage {
    min-block-size: var(--home-mobile-fact-height);
    block-size: var(--home-mobile-fact-height);
    aspect-ratio: auto;
  }

  .orlyata-home__media-section {
    margin-block-start: var(--home-mobile-media-offset);
  }

  .orlyata-home__media-grid {
    row-gap: var(--space-5);
  }


  .orlyata-home__media-grid .orlyata-media-card--big,
  .orlyata-home__media-grid .orlyata-media-card--small {
    height: auto;
    aspect-ratio: auto;
  }

  .orlyata-home__history-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .orlyata-home__history-intro,
  .orlyata-home__history-details {
    display: contents;
  }

  .orlyata-home__history-lead {
    order: 1;
    margin-block-start: 0;
  }

  .orlyata-home__history-teachers {
    order: 2;
    position: static;
    margin-block-start: var(--home-mobile-space-16);
  }

  .orlyata-home__history-copy {
    order: 3;
    inline-size: 100%;
    margin-block-start: var(--space-5);
  }

  .orlyata-home__history,
  .orlyata-home__history-grid,
  .orlyata-home__history-intro,
  .orlyata-home__history-details,
  .orlyata-home__application-surface {
    min-height: 0;
  }

  .orlyata-home__history-tags {
    display: none;
    position: static;
    margin-block-start: var(--space-5);
  }

  .orlyata-home__achievements .orlyata-data-table--achievements tbody tr {
    display: grid;
    grid-template-columns: var(--data-table-mobile-leading-track) minmax(0, 1fr);
    row-gap: var(--home-mobile-achievements-competition-gap);
    padding-block: 0 var(--home-mobile-space-12);
    margin-block-end: var(--home-mobile-space-12);
  }

  .orlyata-home__achievements .orlyata-data-table--achievements tbody td {
    width: auto;
    min-block-size: 0;
    padding: 0;
  }

  .orlyata-home__achievements .orlyata-data-table--achievements tbody td::before {
    content: none;
  }

  .orlyata-home__achievements .orlyata-data-table--achievements tbody :is(td) {
    color: var(--color-text-primary);
    font-size: var(--font-size-body);
    font-weight: 500;
    letter-spacing: var(--letter-spacing-body);
    line-height: var(--line-height-body);
  }

  .orlyata-home__achievements .orlyata-data-table--achievements tbody td:nth-child(1) {
    grid-column: 1;
    grid-row: 1;
  }

  .orlyata-home__achievements .orlyata-data-table--achievements tbody td:nth-child(2) {
    grid-column: 2;
    grid-row: 1;
    margin-inline-start: var(--home-mobile-space-32);
  }


  .orlyata-home__achievements .orlyata-data-table--achievements tbody td:nth-child(3) {
    grid-column: 2 / -1;
    grid-row: 2;
    inline-size: auto;
    margin-inline-start: var(--home-mobile-space-32);
    color: var(--color-text-secondary);
    font-weight: 400;
    line-height: var(--line-height-body);
  }

  .orlyata-home__application-surface {
    aspect-ratio: auto;
    padding-inline: var(--home-mobile-space-12);
  }
}

@media (width >= 768px) and (width <= 1279px) {
  body.home,
  body:has(.orlyata-about),
  body:has(.orlyata-news),
  body:has(.orlyata-media-gallery),
  body:has(.orlyata-news-detail),
  :root:has(.orlyata-home),
  :root:has(.orlyata-about),
  :root:has(.orlyata-news),
  :root:has(.orlyata-media-gallery),
  :root:has(.orlyata-news-detail),
  .orlyata-home,
