    --accordion-icon-glyph-size: clamp(0.900704rem, 1.876466vw, 1.500000rem);
    --accordion-icon-stroke: clamp(0.075059rem, 0.156372vw, 0.125000rem);
    --advantage-width: clamp(14.560776rem, 30.334949vw, 24.249000rem);
    --advantage-height: clamp(6.379984rem, 13.291634vw, 10.625000rem);
    --advantage-padding-block-start: clamp(0.900704rem, 1.876466vw, 1.500000rem);
