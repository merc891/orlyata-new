    --distance-application-form-success-reveal: clamp(0.300235rem, 0.625489vw, 0.500000rem);
    --application-form-padding: clamp(1.200938rem, 2.501955vw, 2.000000rem);
    --application-form-success-padding-block: clamp(1.351056rem, 2.814699vw, 2.250000rem);
    --application-form-gap: clamp(0.900704rem, 1.876466vw, 1.500000rem);
