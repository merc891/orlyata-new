    --news-card-padding: clamp(0.900704rem, 1.876466vw, 1.500000rem);
    --news-card-gap: clamp(0.600469rem, 1.250977vw, 1.000000rem);
    --media-card-big-width: clamp(29.910267rem, 62.313057vw, 49.811500rem);
    --media-card-big-height: clamp(20.265833rem, 42.220485vw, 33.750000rem);
    --media-card-big-padding-block: clamp(1.200938rem, 2.501955vw, 2.000000rem);
