{
  "name": "orlyata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "storybook": "storybook dev --host 0.0.0.0 --port 6006 --no-open",
    "build:admin": "tsc -p tsconfig.admin-media.json",
    "build": "npm run build:admin && vite build",
    "build:storybook": "storybook build --output-dir public-artifacts/storybook",
    "build:stage": "npm run build && npm run build:storybook",
    "typecheck": "tsc --noEmit",
    "lint:ts": "eslint wp-content/themes/orlyata/assets/src wp-content/mu-plugins/orlyata-core/src/Admin vite.config.ts playwright.config.ts .storybook stories tests",
    "lint:css": "stylelint \"wp-content/themes/orlyata/assets/src/**/*.css\" \".storybook/**/*.css\" \"docs/design-system/tokens.css\"",
    "lint": "npm run typecheck && npm run lint:ts && npm run lint:css",
    "test:storybook": "playwright test",
    "test:storybook:update": "playwright test --update-snapshots",
    "check": "npm run lint && npm run build && npm run build:storybook"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/html-vite": "^10.5.7",
    "@types/node": "^24.0.0",
    "eslint": "10.8.0",
    "globals": "17.7.0",
    "storybook": "^10.5.7",
    "stylelint": "17.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5"
  },
  "dependencies": {
    "morphicons": "^1.7.0",
    "photoswipe": "5.4.4"
  }
}
