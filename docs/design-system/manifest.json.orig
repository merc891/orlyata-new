  "components": {
    "Button": {
      "path": "wp-content/themes/orlyata/template-parts/components/button.php",
      "figma": "Button / 4651:1140",
      "variants": [
        "primary",
        "secondary",
        "play",
        "arrow-left",
        "arrow-right"
      ],
      "states": [
        "default",
        "hover",
        "focus-visible",
        "active",
        "disabled",
        "loading"
      ],
      "usage_rules": [
        "Use a real button for actions and a real link for navigation",
        "Do not invent one-off colors or radii"
      ],
      "do_not": [
        "Do not nest links inside buttons",
        "Do not remove visible focus treatment"
      ],
      "gaps": [
        "tablet sizing refinement in stage 6",
        "mobile sizing refinement in stage 6"
      ],
      "geometry": {
        "standard-height-rem": 4,
        "standard-padding-block-rem": 0.75,
        "standard-padding-inline-rem": 1.5,
        "standard-label-token": "typography.body",
        "standard-radius-token": "radius.full",
        "play-default-size-rem": 4,
        "play-hover-size-rem": 5,
        "arrow-size-rem": 4,
        "standard-icon-size-rem": 1.5,
        "play-icon-size-rem": 1,
        "arrow-icon-size-rem": 1.5,
        "gap-rem": 0.5
      },
      "state_contract": {
        "hover": "Primary uses interaction.hover-opacity while preserving exactly the default geometry and padding; secondary and icon controls use neutral-100/muted surfaces as shown in Figma. Text variants without the close icon keep 1.5rem (24px) end padding in every state. Play transitions size with duration-button-play-hover (800ms) and easing-out; arrows transition background with duration-micro and easing-out.",
        "focus-visible": "Brand outline uses interaction focus ring width and offset and remains a real keyboard behavior, but is not duplicated as an artificial Storybook specimen.",
        "active": "Use interaction.active-opacity and preserve Primary geometry during real pointer hover.",
        "disabled": "Use native disabled for buttons or aria-disabled without href for links, interaction.disabled-opacity, and suppress hover/active.",
        "loading": "Button-only state: set disabled and aria-busy, replace visible label, hide optional icon, and do not add motion before motion tokens exist."
      },
      "semantics": {
        "action": "button",
        "navigation": "a",
        "icon-only": "Requires a non-empty accessible label; SVGs are decorative.",
        "loading": "Not valid for links."
      },
      "responsive": "Keep the 4rem base control size and at least 44px target in desktop, tablet and mobile. Component-specific tablet/mobile refinements belong to stage 6; no Button breakpoint is introduced in stage 3.",
      "status": "implemented-stage-3",
      "implemented_at": "2026-08-14",
      "implementation": {
        "template": "wp-content/themes/orlyata/template-parts/components/button.php",
        "styles": "wp-content/themes/orlyata/assets/src/styles/components/button.css",
        "story": "stories/components/button.stories.ts",
        "assets": [
          "wp-content/themes/orlyata/assets/icons/button-close.svg",
          "wp-content/themes/orlyata/assets/icons/button-play.svg",
          "wp-content/themes/orlyata/assets/icons/button-arrow.svg"
        ]
      },
