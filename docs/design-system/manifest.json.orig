  "layout": {
    "grid": "Desktop evidence uses a persistent left navigation rail and a wide editorial content area. Exact columns and gutters must be measured per frame before implementation.",
    "page_width": "The desktop design target is a 1920 px viewport. Inspected 1900 px Figma frames are normalized to 1920 during implementation. Reviewed fluid values continue scaling to 2560 px; beyond 2560 px the composition is centred.",
    "section_rhythm": "Large editorial sections separated primarily by whitespace, rules and surface changes rather than repeated card containers.",
    "density": "Spacious marketing sections with denser data tables for news, scores and achievements.",
    "responsive_rules": [
      "Use exactly three global layout modes: mobile 320–767, tablet 768–1279, desktop 1280–2560+.",
      "Keep html font-size at 100%; do not implement global viewport scaling through the root font size.",
      "Use rem for type, spacing, component size and radius. Use vw only as the fluid term of reviewed clamp() tokens.",
      "Media queries use px and 1px is allowed for hairline borders.",
      "Components may recompose at 1280 and 768; mobile is not a uniformly shrunken desktop.",
      "Do not add global breakpoints without updating this manifest first.",
      "Support 320 px without horizontal page scrolling and without clipping text.",
      "Between 1920 and 2560 px, reviewed fluid values may continue growing. Above 2560 px, full-bleed backgrounds may extend but content and typography do not continue growing."
    ]
  },
