    "MediaCard": {
      "path": "wp-content/themes/orlyata/template-parts/components/media-card.php",
      "figma": "Card / 4651:1333",
      "variants": [
        "big",
        "small",
        "photo",
        "video"
      ],
      "states": [
        "default",
        "hover",
        "focus-within",
        "video-preview-playing"
      ],
      "usage_rules": [
        "Preserve image aspect ratio per variant",
        "Show provider and media type without relying on color alone",
        "Big and small variants are both 540px high on desktop",
        "Small keeps 16px between image and title and aligns metadata badges to the bottom",
        "Big uses inverse Badge over imagery",
        "Big and small titles use their Figma heading roles at weight 500",
        "Hover and focus-within scale only the clipped image to 110% over motion.duration-micro with motion.easing-out; card geometry stays fixed",
        "Keep the image gradient below MediaCard content and decorative Play; card hover and focus-within trigger the standard Play growth from 64px to 80px",
        "Show the decorative Play marker only for the video media type in either card size: 24px from the left/top in Big and 24px from the left plus 16px from the top inside Small imagery",
        "The MediaCard Playground replaces imagery with a muted native-video preview immediately for video; a direct MP4/WebM URL plays for exactly 8 seconds from the saved offset and loops",
        "MediaCard video previews remain active under prefers-reduced-motion because they are requested media content rather than a decorative transition; load and player errors use the static fallback",
        "The video-card link opens the external provider URL in a separate tab; Play does not create a separate action",
        "Derive the visible provider tag from the URL for YouTube, RuTube and VK Video"
      ],
      "do_not": [
        "Do not expose Play as a nested interactive control or prevent the card link from opening the external video",
        "Do not use low-resolution source images"
      ],
      "gaps": [
        "missing image",
        "long title",
        "provider fallback",
        "tablet",
        "mobile"
      ]
    },
    "ApplicationForm": {
      "path": "wp-content/themes/orlyata/template-parts/sections/application-form.php",
      "figma": "Form containers 4527:7798, 4527:7830, 4527:8773",
