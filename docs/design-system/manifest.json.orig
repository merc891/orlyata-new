  "visual_language": {
    "mood": "Warm, confident and contemporary editorial identity: youthful without childish decoration, institutional without bureaucracy.",
    "composition_rules": [
      "Use the green brand accent sparingly against white and near-black surfaces.",
      "Use large photography and typographic hierarchy as primary visual devices.",
      "Use a soft green-to-dark atmospheric gradient only in approved hero and application contexts.",
      "Keep data-heavy sections flat, aligned and readable; use rules rather than nested cards.",
      "Preserve generous whitespace between major sections."
    ],
    "imagery_rules": [
      "Prioritise authentic photographs of the choir, performances, teachers and community.",
      "Never distort or arbitrarily crop faces; define focal points where supported.",
      "Use approved aspect ratios per MediaCard variant and responsive mode.",
      "Do not upscale weak migration assets without review."
    ],
    "iconography_rules": [
      "Use the existing simple monochrome icon language and the approved category mapping.",
      "Social icons may be editor-managed SVG only after sanitisation.",
      "Icons supplement labels and must not be the only accessible name."
    ],
    "motion_rules": [
      "Motion supports state change and orientation, never decoration for its own sake.",
      "No autoplay media or continuous ornamental motion.",
      "Respect prefers-reduced-motion."
    ],
    "anti_patterns": [
      "Unowned accent colors or new gradients",
      "Glassmorphism and floating translucent panels",
      "Nested decorative cards",
      "Pill overload",
      "Generic dashboard widgets",
      "Arbitrary type sizes or spacing outside tokens",
      "Desktop scaled down uniformly for mobile",
      "Decorative animation that delays content"
    ]
  },
  "accessibility": {
    "contrast_policy": "Target WCAG 2.2 AA for text and meaningful controls. Validate the green/white and secondary-text combinations before release.",
    "keyboard_policy": "All navigation, filters, accordions, galleries and forms must work by keyboard in a logical DOM order.",
    "focus_policy": "Every interactive element has a visible :focus-visible style not dependent on hover. Focus styling is a required design-system gap to resolve.",
    "reduced_motion_policy": "Disable or simplify non-essential transitions under prefers-reduced-motion: reduce."
  },
  "governance": {
    "token_policy": "Use semantic CSS custom properties backed by this manifest. Raw values are allowed only while defining a token, not at call sites.",
    "component_policy": "Reuse an owned component before creating a local variant. Every interactive component ships with all applicable states and responsive behaviour.",
    "when_to_add_new_tokens": "Add a token when a new semantic role is approved or a value repeats across at least two owned components. Document source and intended role.",
    "when_to_add_new_components": "Add a component for repeated structure or behaviour with a stable API. One-off page composition remains a section, not a universal component."
  },
  "open_questions": [
    "Design and approve tablet and mobile typography, layout, navigation and all component variants.",
    "Audit hard-coded Figma spacing values and complete the spacing scale before implementation.",
